            Shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
            Lightbulb: "M9 18h6 M10 22h4 M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 12 2a4.65 4.65 0 0 0-4.5 9.5c.75.76 1.22 1.52 1.4 2.5h6.2z",
            Building: "M3 21h18M3 7V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2M3 7v14M21 7v14M9 3v18M15 3v18M7 7h2M7 11h2M7 15h2M15 7h2M15 11h2M15 15h2",
            Phone: "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z",
            User: "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8",
            FileText: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8",
            LayoutGrid: "M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z",
            LogOut: "M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9",
            Search: "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"
        };
        const Icon = ({ name, size = 20, className = "" }) => <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d={ICONS_DATA[name] || ""} /></svg>;

        const SignaturePad = ({ onSave, onClear }) => {
            const canvasRef = useRef(null);
            const [isDrawing, setIsDrawing] = useState(false);
            useEffect(() => {
                const canvas = canvasRef.current;
                const resize = () => { const r = canvas.getBoundingClientRect(); canvas.width = r.width; canvas.height = r.height; const ctx = canvas.getContext('2d'); ctx.lineWidth = 2; ctx.lineCap = 'round'; ctx.strokeStyle = 'white'; };
                resize(); window.addEventListener('resize', resize);
                return () => window.removeEventListener('resize', resize);
            }, []);
            const getCoords = (e) => { const r = canvasRef.current.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
            const start = (e) => { const {x,y} = getCoords(e.nativeEvent); const ctx = canvasRef.current.getContext('2d'); ctx.beginPath(); ctx.moveTo(x,y); setIsDrawing(true); };
            const draw = (e) => { if(!isDrawing)return; const {x,y} = getCoords(e.nativeEvent); const ctx = canvasRef.current.getContext('2d'); ctx.lineTo(x,y); ctx.stroke(); };
            const stop = () => { if(isDrawing) { canvasRef.current.getContext('2d').closePath(); setIsDrawing(false); } };
            return (
                <div className="flex flex-col gap-2">
                    <div className="border border-slate-600 bg-slate-900 rounded h-32 w-full shadow-inner overflow-hidden cursor-crosshair">
                        <canvas ref={canvasRef} onMouseDown={start} onMouseMove={draw} onMouseUp={stop} onMouseLeave={stop} className="w-full h-full block"/>
                    </div>
                    <div className="flex gap-2 text-xs">
                        <button type="button" onClick={() => onSave(canvasRef.current.toDataURL())} className="bg-indigo-600 px-3 py-1 rounded text-white hover:bg-indigo-500 font-bold">تأكيد</button>
                        <button type="button" onClick={() => { const ctx = canvasRef.current.getContext('2d'); ctx.clearRect(0,0,canvasRef.current.width,canvasRef.current.height); onClear(); }} className="bg-slate-700 text-slate-300 px-3 py-1 rounded hover:bg-slate-600 font-bold">مسح</button>
                    </div>
                </div>
            );
        };

        const INITIAL_SCREENS = Array.from({ length: 12 }, (_, i) => ({
            id: i + 1, charId: String.fromCharCode(65 + i), name: `شاشة العرض ${i + 1}`, status: 'active', statusReason: '', 
            cameras: Array.from({ length: 10 }, (_, j) => ({
                id: `${i + 1}-${j + 1}`, number: j + 1, name: `كاميرا ${j + 1}`, code: `CAM-${i + 1}-${j + 1}`, status: 'active', note: '', lastUpdate: '10:00',
                storage: { dailyHours: '24', retentionDays: '30' }, incidents: [], inspections: [], recordings: [], maintenance: []
            }))
        }));
        const INITIAL_USERS = [{ id: 1, name: 'Admin', code: '1234', role: 'admin' }];

        function SecurityDashboard() {
            const load = (k, d) => { try { const s = localStorage.getItem(k); return s ? JSON.parse(s) : d; } catch { return d; } };
            const [users, setUsers] = useState(() => load('cctv_users_v2', INITIAL_USERS));
            const [screens, setScreens] = useState(() => load('cctv_screens_v2', INITIAL_SCREENS));
            const [externalDepts, setExternalDepts] = useState(() => load('cctv_external_v2', []));
            const [policyFiles, setPolicyFiles] = useState(() => load('cctv_policies_v2', []));
            const [activityLog, setActivityLog] = useState(() => load('cctv_activity_log', []));
            
            const [currentUser, setCurrentUser] = useState(null);
            const [accessCode, setAccessCode] = useState('');
            const [loginError, setLoginError] = useState(false);
            
            const [currentView, setCurrentView] = useState('overview');
            const [selectedScreenId, setSelectedScreenId] = useState(null);
            const [selectedCamera, setSelectedCamera] = useState(null);
            
            const [activeControlTab, setActiveControlTab] = useState('storage');
            const [currentTime, setCurrentTime] = useState(new Date());

            // Forms State
            const [newExternal, setNewExternal] = useState({ deptName: '', camCount: '', storage: '', manager: '', phone: '' });
            const [viewingFile, setViewingFile] = useState(null);
            const pdfInputRef = useRef(null);
            const [newUser, setNewUser] = useState({ name: '', code: '', role: 'viewer' });
            const [adminNewCode, setAdminNewCode] = useState('');
            const fileInputRef = useRef(null);

            const logAction = (action, details) => {
                const newLog = { id: Date.now(), time: new Date().toLocaleTimeString('ar-SA'), action, details };
                const updated = [newLog, ...activityLog].slice(0, 50);
                setActivityLog(updated);
                localStorage.setItem('cctv_activity_log', JSON.stringify(updated));
            };

            useEffect(() => { localStorage.setItem('cctv_screens_v2', JSON.stringify(screens)); }, [screens]);
            useEffect(() => { localStorage.setItem('cctv_users_v2', JSON.stringify(users)); }, [users]);
            useEffect(() => { localStorage.setItem('cctv_external_v2', JSON.stringify(externalDepts)); }, [externalDepts]);
            useEffect(() => { localStorage.setItem('cctv_policies_v2', JSON.stringify(policyFiles)); }, [policyFiles]);
            useEffect(() => { const t = setInterval(() => setCurrentTime(new Date()), 1000); return () => clearInterval(t); }, []);

            const handleLogin = (e) => {
                e.preventDefault();
                const normalizedCode = accessCode.trim().replace(/[٠-٩]/g, d => "٠١٢٣٤٥٦٧٨٩".indexOf(d)).replace(/[۰-۹]/g, d => "۰۱۲۳۴۵۶۷۸۹".indexOf(d));
                const u = users.find(x => x.code === normalizedCode);
                if (u) { setCurrentUser(u); setLoginError(false); logAction('Login', `User ${u.name} logged in`); } 
                else setLoginError(true);
            };
            
            const updateCameraData = (sid, cid, sec, data, isEdit = false, delId = null) => { 
                setScreens(prev => prev.map(s => s.id !== sid ? s : { 
                    ...s, cameras: s.cameras.map(c => c.id !== cid ? c : { 
                        ...c, [sec]: sec === 'storage' ? { ...c.storage, ...data } : 
                        (delId !== null ? (c[sec]||[]).filter(x => x.id !== delId) : 
                        (isEdit ? (c[sec]||[]).map(x => x.id === data.id ? data : x) : [data, ...(c[sec]||[])]))
                    })
                }));
            };

            // Entity Handlers
            const handleAddExternal = (e) => { e.preventDefault(); if(newExternal.deptName && newExternal.manager) { setExternalDepts([...externalDepts, { id: Date.now(), ...newExternal }]); setNewExternal({ deptName: '', camCount: '', storage: '', manager: '', phone: '' }); logAction('External', `Added dept: ${newExternal.deptName}`); } };
            const handleDeleteExternal = (id) => { if(confirm('هل أنت متأكد من الحذف؟')) { setExternalDepts(externalDepts.filter(d => d.id !== id)); logAction('External', 'Deleted department'); } };
            
            const handleUploadPolicy = (event) => {
                const file = event.target.files[0];
                if (!file) return;
                if (file.type !== 'application/pdf') { alert('يرجى اختيار ملف PDF فقط'); return; }
                if (file.size > 2097152) { alert('حجم الملف كبير جداً. يجب أن يكون أقل من 2MB'); return; }
                const reader = new FileReader();
                reader.onload = (e) => {
                    const newFile = { id: Date.now(), name: file.name, size: (file.size / 1024).toFixed(2) + ' KB', date: new Date().toLocaleDateString('en-US'), data: e.target.result };
                    setPolicyFiles([...policyFiles, newFile]);
                    logAction('Policy', `Uploaded file: ${file.name}`);
                };
                reader.readAsDataURL(file);
                event.target.value = null;
            };
            const handleDeletePolicy = (id) => { if(confirm('حذف الملف؟')) { setPolicyFiles(policyFiles.filter(f => f.id !== id)); logAction('Policy', 'Deleted file'); } };

            const handleAddUser = (e) => { e.preventDefault(); if (newUser.name && newUser.code) { setUsers([...users, { id: Date.now(), ...newUser }]); setNewUser({ name: '', code: '', role: 'viewer' }); logAction('Admin', `Added user: ${newUser.name}`); } };
            const handleDeleteUser = (id) => { if(confirm('حذف المستخدم؟')) { setUsers(users.filter(u => u.id !== id)); logAction('Admin', 'Deleted user'); } };
            const handleUpdateAdminCode = (e) => { e.preventDefault(); if (adminNewCode) { setUsers(users.map(u => u.role === 'admin' ? { ...u, code: adminNewCode } : u)); setAdminNewCode(''); alert('تم التحديث'); logAction('Admin', 'Updated admin code'); } };
            
            const handleFactoryReset = () => { if(confirm('تحذير: سيتم حذف جميع البيانات. هل أنت متأكد؟')) { setScreens(INITIAL_SCREENS); setUsers(INITIAL_USERS); setExternalDepts([]); setPolicyFiles([]); localStorage.clear(); window.location.reload(); } };
            const handleExportData = () => { const data = { screens, users, externalDepts, policyFiles }; const url = URL.createObjectURL(new Blob([JSON.stringify(data,null,2)], {type:'application/json'})); const a=document.createElement('a'); a.href=url; a.download='backup.json'; a.click(); };

            const totalCameras = screens.reduce((acc, s) => acc + s.cameras.length, 0);
            const totalIncidents = screens.reduce((acc, s) => acc + s.cameras.reduce((cAcc, c) => cAcc + (c.incidents?.length || 0), 0), 0);
            
            const Sidebar = () => (
                <aside className="w-64 glass-panel m-4 ml-0 flex flex-col p-4 flex-shrink-0 h-[calc(100vh-2rem)] sticky top-4">
                    <div className="flex items-center gap-3 mb-8 px-2">
                        <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/25">
                            <Icon name="Cctv" className="text-white" size={24} />
                        </div>
                        <div>
                            <h2 className="text-white font-bold text-sm">غرفة التحكم</h2>
                            <span className="text-slate-400 text-[10px]">Security Control</span>
                        </div>
                    </div>

                    <nav className="space-y-1 flex-1 overflow-y-auto custom-scrollbar">
                        <div onClick={() => { setCurrentView('overview'); setSelectedScreenId(null); }} className={`sidebar-item w-full flex items-center gap-3 px-3 py-3 text-sm ${currentView === 'overview' && !selectedScreenId ? 'active text-indigo-400' : 'text-slate-400 hover:text-indigo-300'}`}>
                            <Icon name="LayoutGrid" size={18} />
                            <span>نظرة عامة</span>
                        </div>
                        
                        <div className="pt-4 pb-2 text-[10px] font-bold text-slate-500 uppercase">الوصول السريع للشاشات</div>
                        <div className="space-y-1 pr-1 mb-4">
                           {screens.map(s => (
                               <div key={s.id} onClick={() => { setSelectedScreenId(s.id); setCurrentView('screen-view'); }} className={`sidebar-item w-full flex items-center gap-3 px-3 py-2 text-xs ${selectedScreenId === s.id ? 'active text-indigo-400' : 'text-slate-400 hover:text-indigo-300'}`}>
                                   <span className={`w-2 h-2 rounded-full ${s.status === 'active' ? 'bg-green-500' : 'bg-red-500'}`}></span>
                                   <span>{s.name}</span>
                               </div>
                           ))} 
                        </div>

                        {currentUser?.role === 'admin' && (
                            <>
                                <div className="pt-4 pb-2 text-[10px] font-bold text-slate-500 uppercase">الإدارة</div>
                                <div onClick={() => setCurrentView('external')} className={`sidebar-item w-full flex items-center gap-3 px-3 py-3 text-sm ${currentView === 'external' ? 'active text-purple-400' : 'text-slate-400 hover:text-purple-300'}`}>
                                    <Icon name="Building" size={18} />
                                    <span>الأقسام الخارجية</span>
                                </div>
                                <div onClick={() => setCurrentView('policies')} className={`sidebar-item w-full flex items-center gap-3 px-3 py-3 text-sm ${currentView === 'policies' ? 'active text-blue-400' : 'text-slate-400 hover:text-blue-300'}`}>
                                    <Icon name="FileText" size={18} />
