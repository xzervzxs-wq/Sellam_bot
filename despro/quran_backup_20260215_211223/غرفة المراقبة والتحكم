                                            <input placeholder="رقم التسجيل" className="bg-slate-900 rounded p-2 text-sm" value={recordingForm.recNum} onChange={e=>setRecordingForm({...recordingForm, recNum:e.target.value})}/>
                                            <input placeholder="السبب" className="bg-slate-900 rounded p-2 text-sm" value={recordingForm.reason} onChange={e=>setRecordingForm({...recordingForm, reason:e.target.value})}/>
                                            <div className="h-24"><SignaturePad onSave={s => setRecordingForm({...recordingForm, signature:s})} onClear={()=>{}}/></div>
                                            <button onClick={handleAddRec} className="bg-purple-600 text-white rounded p-2 text-sm font-bold mt-2">حفظ السجل</button>
                                        </div>
                                        {cam.recordings?.map(r => <div key={r.id} className="bg-slate-800 p-3 rounded mb-2"><div className="font-bold text-white">{r.reason}</div><div className="text-xs text-slate-400">#{r.recNum} | {r.date}</div>{r.signature && <img src={r.signature} className="h-8 mt-1 border border-slate-600"/>}</div>)}
                                    </div>
                                )}
                                {activeControlTab === 'inspections' && <div className="text-center text-slate-500 mt-10">قائمة الفحص (Checklist) متاح فقط للعرض</div>}
                            </div>
                        </div>
                    </div>
                );
            };

            // Main
            if (!currentUser) return (
                <div className="login-screen fixed inset-0 z-50 flex items-center justify-center p-4">
                    <div className="glass-panel w-full max-w-md p-8 fade-in text-center">
                        <div className="w-16 h-16 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg"><Icon name="ShieldCheck" size={32} className="text-white" /></div>
                        <h1 className="text-2xl font-bold text-white mb-6">غرفة المراقبة</h1>
                        <form onSubmit={handleLogin} className="space-y-4">
                            <input type="password" value={accessCode} onChange={(e) => setAccessCode(e.target.value)} className="w-full bg-slate-900/60 border border-slate-700/50 rounded-xl px-4 py-3 text-white text-center text-lg tracking-[0.5em] outline-none" placeholder="••••" autoFocus />
                            {loginError && <p className="text-red-400 text-xs">رمز الدخول غير صحيح</p>}
                            <button type="submit" className="w-full py-3 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-semibold rounded-xl hover:opacity-90">تسجيل الدخول</button>
                        </form>
                    </div>
                </div>
            );

            return (
                <div className="flex min-h-screen bg-[#0f172a] text-slate-200">
                    <Sidebar />
                    <main className="flex-1 p-4 md:p-8 overflow-y-auto h-screen">
                        <div className="flex items-center justify-between mb-8">
                            <h1 className="text-xl font-bold text-white">
                                {currentView === 'overview' && 'نظرة عامة'}
                                {currentView === 'screen-view' && 'عرض الشاشة'}
                                {currentView === 'external' && 'الأقسام الخارجية'}
                                {currentView === 'policies' && 'السياسات والملفات'}
                                {currentView === 'admin' && 'لوحة المسؤول'}
                            </h1>
                            <div className="bg-slate-800 text-slate-400 px-3 py-2 rounded-lg font-mono text-xs">{currentUser.name}</div>
                        </div>

                        {currentView === 'overview' && <Overview />}
                        {currentView === 'screen-view' && selectedScreenId && <ScreenDetail />}
                        {currentView === 'external' && <ExternalPanel />}
                        {currentView === 'policies' && <PoliciesPanel />}
                        {currentView === 'admin' && <AdminPanel />}
                    </main>

                    <CameraModal />

                    {viewingFile && (
                        <div className="fixed inset-0 z-[100] bg-black/90 flex items-center justify-center p-8">
                            <div className="bg-slate-900 w-full h-full rounded-2xl flex flex-col p-4">
                                <div className="flex justify-between mb-4"><h3 className="text-white font-bold">{viewingFile.name}</h3><button onClick={() => setViewingFile(null)} className="text-white"><Icon name="X"/></button></div>
                                <iframe src={viewingFile.data} className="flex-1 bg-white rounded-lg"></iframe>
                            </div>
                        </div>
                    )}
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<SecurityDashboard />);
    </script>
</body>
</html>
