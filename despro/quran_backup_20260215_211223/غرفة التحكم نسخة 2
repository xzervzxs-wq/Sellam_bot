<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>غرفة المراقبة و التحكم CCTV - نسخة 2</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">

    <style>
        * { font-family: 'Alexandria', sans-serif; }
        
        body { 
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        .login-screen {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
        }

        .login-card {
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(99, 102, 241, 0.2);
        }

        .login-input {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(99, 102, 241, 0.2);
            transition: all 0.3s;
        }

        .login-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #1e293b; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 8px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748b; }

        .stat-card {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(51, 65, 85, 0.4);
            border-radius: 16px;
            transition: all 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: rgba(99, 102, 241, 0.3);
            box-shadow: 0 8px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .accent-btn {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            transition: all 0.3s;
            box-shadow: 0 8px 25px -5px rgba(99, 102, 241, 0.3);
        }

        .accent-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px -5px rgba(99, 102, 241, 0.4);
        }

        .accent-btn:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // --- ICONS DATA ---
        const ICONS_DATA = {
            Video: "M23 7l-7 5 7 5V7z M14 5H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2z",
            Activity: "M22 12h-4l-3 9L9 3l-3 9H2",
            ArrowRight: "M5 12h14 M12 5l7 7-7 7",
            CheckCircle: "M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4L12 14.01l-3-3",
            Clock: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 6v6l4 2",
            AlertTriangle: "M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01",
            X: "M18 6L6 18 M6 6l12 12",
            Plus: "M12 5v14 M5 12h14",
            Lock: "M19 11H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2z M7 11V7a5 5 0 0 1 10 0v4",
            Cctv: "M16.75 8.75a3 3 0 1 1-5.5 0 3 3 0 0 1 5.5 0z M2 13h2 M4 13a3 3 0 0 0 3-3V7a3 3 0 0 1 3-3h7a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3v-2",
            ShieldCheck: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4",
            UserCog: "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z",
            Settings: "M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.74v-.47a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",
            Edit3: "M12 20h9 M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z",
            Save: "M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8V3"
        };

        const Icon = ({ name, size = 24, className = "" }) => {
            const pathData = ICONS_DATA[name];
            if (!pathData) return null;
            return (
                <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}>
                    <path d={pathData} />
                </svg>
            );
        };

        // --- Initial Data ---
        const INITIAL_SCREENS = Array.from({ length: 12 }, (_, i) => ({
            id: i + 1, charId: String.fromCharCode(65 + i), name: `شاشة العرض ${i + 1}`, status: 'active', statusReason: '', 
            cameras: Array.from({ length: 10 }, (_, j) => ({
                id: `${i + 1}-${j + 1}`, number: j + 1, name: `كاميرا ${j + 1}`, code: `CAM-${i + 1}-${j + 1}`, status: 'active', note: '', lastUpdate: '10:00',
                storage: { dailyHours: '24', retentionDays: '30' }, incidents: [], inspections: [], recordings: [], maintenance: []
            }))
        }));
        const INITIAL_USERS = [{ id: 1, name: 'Admin', code: '1234', role: 'admin' }];

        // --- Video Placeholder ---
        const VideoPlaceholder = ({ id, code, status }) => {
            let borderColor = 'border-slate-700';
            let statusText = '', statusColor = 'text-slate-400';
            if(status==='active'){ borderColor='border-green-500/50'; statusText='● LIVE'; statusColor='text-green-500'; }
            else if(status==='error'){ borderColor='border-red-500/50'; statusText='○ OFFLINE'; statusColor='text-red-500'; }
            else if(status==='warning'){ borderColor='border-orange-500/50'; statusText='⚠ DISABLED'; statusColor='text-orange-500'; }
            return (
                <div className={`relative w-full h-32 bg-slate-800 rounded-md overflow-hidden border-2 ${borderColor} group transition-all duration-300 shadow-inner`}>
                    <div className="absolute inset-0 flex items-center justify-center text-slate-600 group-hover:text-slate-500 transition-colors"><Icon name="Video" size={32}/></div>
                    <div className={`absolute top-2 left-2 text-xs font-bold font-mono ${statusColor} ${status==='active'?'animate-pulse':''}`}>{statusText}</div>
                    <div className="absolute bottom-2 right-2 text-xs text-slate-500 font-bold font-mono bg-slate-900/70 px-1 rounded shadow-sm">{code || `CAM-${id}`}</div>
                    <div className="absolute inset-0 bg-gradient-to-b from-transparent to-black/5 pointer-events-none"></div>
                </div>
            );
        };

        // --- Main Component ---
        function SecurityDashboard() {
            const load = (k, d) => { try { const s = localStorage.getItem(k); return s ? JSON.parse(s) : d; } catch { return d; } };
            const [users, setUsers] = useState(() => load('cctv_users', INITIAL_USERS));
            const [currentUser, setCurrentUser] = useState(null);
            const [accessCode, setAccessCode] = useState('');
            const [loginError, setLoginError] = useState(false);
            const [selectedCameraForControl, setSelectedCameraForControl] = useState(null);
            const [activeControlTab, setActiveControlTab] = useState('storage');
            const [screens, setScreens] = useState(() => load('cctv_screens', INITIAL_SCREENS));
            const [selectedScreenId, setSelectedScreenId] = useState(null);
            const [currentTime, setCurrentTime] = useState(new Date());
            const [isEditMode, setIsEditMode] = useState(false);

            useEffect(() => { localStorage.setItem('cctv_screens', JSON.stringify(screens)); }, [screens]);
            useEffect(() => { localStorage.setItem('cctv_users', JSON.stringify(users)); }, [users]);
            useEffect(() => { const t = setInterval(() => setCurrentTime(new Date()), 1000); return () => clearInterval(t); }, []);

            const handleLogin = (e) => { e.preventDefault(); const u = users.find(x => x.code === accessCode); if(u){ setCurrentUser(u); setLoginError(false); setAccessCode(''); } else setLoginError(true); };
            const handleLogout = () => { setCurrentUser(null); setSelectedScreenId(null); setIsEditMode(false); setSelectedCameraForControl(null); };

            const handleBack = () => { setSelectedScreenId(null); setIsEditMode(false); };
            const addNewScreen = () => { const newId = screens.length > 0 ? Math.max(...screens.map(s => s.id)) + 1 : 1; const newScreen = { id: newId, charId: String.fromCharCode(65 + (screens.length % 26)), name: `شاشة جديدة ${newId}`, location: '', status: 'active', cameras: [{ id: `${newId}-1`, number: 1, name: 'كاميرا 1', code: `CAM-${newId}-1`, status: 'active', note: '', lastUpdate: new Date().toLocaleTimeString('en-US'), storage: {dailyHours: 24, retentionDays: 30}, incidents: [], inspections: [], recordings: [], maintenance: [] }] }; setScreens([...screens, newScreen]); };

            const activeScreen = screens.find(s => s.id === selectedScreenId);
            const isAdmin = currentUser?.role === 'admin';
            const currentControlledCamera = selectedCameraForControl ? screens.find(s => s.id === selectedCameraForControl.screenId)?.cameras.find(c => c.id === selectedCameraForControl.camera.id) : null;

            // --- Login View ---
            if (!currentUser) return (
                <div className="login-screen min-h-screen flex flex-col items-center justify-center p-4 relative overflow-hidden">
                    <div className="fixed inset-0 z-0 overflow-hidden pointer-events-none">
                        <div className="absolute -top-[10%] -right-[10%] w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl"></div>
                        <div className="absolute -bottom-[10%] -left-[10%] w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
                    </div>

                    <div className="w-full max-w-md login-card p-8 rounded-3xl relative z-10 border-2">
                        <div className="flex flex-col items-center gap-6">
                            <div className="w-24 h-24 bg-gradient-to-br from-indigo-600 to-blue-600 rounded-2xl flex items-center justify-center shadow-2xl shadow-indigo-600/40">
                                <Icon name="Cctv" size={48} className="text-white" />
                            </div>

                            <div className="text-center space-y-2 w-full">
                                <h1 className="text-3xl font-black text-white">غرفة المراقبة و التحكم</h1>
                                <p className="text-indigo-300 text-sm font-bold">CCTV Security Management System v2.0</p>
                                <p className="text-slate-400 text-xs mt-3">إدارة الأمن و السلامة</p>
                            </div>

                            <form onSubmit={handleLogin} className="w-full space-y-5 mt-4">
                                <div className="space-y-2">
                                    <label className="text-xs font-black text-indigo-300 uppercase tracking-wider mr-1">رمز الدخول</label>
                                    <div className="relative">
                                        <div className="absolute right-4 top-4 text-indigo-400"><Icon name="Lock" size={18}/></div>
                                        <input 
                                            type="password" 
                                            value={accessCode} 
                                            onChange={(e) => setAccessCode(e.target.value)} 
                                            className="login-input w-full rounded-lg py-3 pr-12 pl-4 text-center tracking-[0.5em] text-xl font-black text-white focus:border-indigo-500 outline-none placeholder-slate-500 shadow-xl"
                                            placeholder="••••" 
                                            autoFocus 
                                        />
                                    </div>
                                </div>

                                {loginError && (
                                    <div className="text-red-400 text-xs text-center font-black bg-red-500/10 py-3 rounded-lg border border-red-500/20 animate-pulse">
                                        ❌ رمز الدخول غير صحيح
                                    </div>
                                )}

                                <button 
                                    type="submit" 
                                    className="accent-btn w-full text-white font-black py-3 rounded-lg flex items-center justify-center gap-2 transform transition-all duration-200"
                                >
                                    <Icon name="ShieldCheck" size={20}/> دخول النظام
                                </button>
                            </form>

                            <div className="w-full border-t border-slate-600 pt-5 mt-5 text-center">
                                <p className="text-xs text-slate-500 font-bold">النسخة 2.0 - تحديث محسّن</p>
                                <p className="text-[10px] text-slate-600 mt-1">✓ يعمل بدون اتصال إنترنت</p>
                            </div>
                        </div>
                    </div>
                </div>
            );

            // --- Main Dashboard ---
            return (
                <div className="min-h-screen text-white selection:bg-indigo-500 selection:text-white relative flex flex-col transition-colors duration-300" style={{background: 'linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%)'}}>
                    {selectedCameraForControl && currentControlledCamera && (
                        <div className="fixed inset-0 z-[60] bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
                            <div className="bg-slate-950 border border-indigo-500/20 rounded-2xl w-full max-w-5xl h-[90vh] flex flex-col shadow-2xl overflow-hidden">
                                <div className="bg-slate-900 p-4 flex justify-between items-center border-b border-indigo-500/20">
                                    <div><h2 className="text-xl font-bold flex items-center gap-2 text-white"><Icon name="Cctv" className="text-indigo-500"/>{currentControlledCamera.name}</h2></div>
                                    <button onClick={() => { setSelectedCameraForControl(null); }} className="p-2 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition-colors"><Icon name="X" size={24}/></button>
                                </div>
                                <div className="flex flex-1 overflow-hidden">
                                    <div className="w-64 bg-slate-900/50 border-l border-indigo-500/20 flex flex-col p-2 gap-2 overflow-y-auto">
                                        {[{ id: 'storage', icon: 'Clock', label: 'سعة التسجيل' }].map(tab => (
                                            <button key={tab.id} onClick={() => setActiveControlTab(tab.id)} className={`p-3 rounded-lg text-right flex items-center gap-3 transition-colors ${activeControlTab === tab.id ? `bg-slate-800 border border-indigo-500/30 shadow-lg` : 'hover:bg-slate-800/50'}`}>
                                                <div className={`p-2 rounded`}><Icon name={tab.icon} size={18}/></div><span className={`text-sm font-bold`}>{tab.label}</span>
                                            </button>
                                        ))}
                                    </div>
                                    <div className="flex-1 bg-slate-900/30 p-6 overflow-y-auto">
                                        {activeControlTab === 'storage' && <div className="space-y-6">
                                            <h3 className="text-lg font-bold text-indigo-400 border-b border-indigo-500/20 pb-2">سعة التسجيل والتخزين</h3>
                                            <div className="grid grid-cols-2 gap-6">
                                                <div className="bg-slate-800/50 p-6 rounded-xl border border-indigo-500/20 text-center">
                                                    <div className="mx-auto text-indigo-400 mb-2 flex justify-center"><Icon name="Clock" size={32}/></div>
                                                    <h4 className="text-slate-400 text-sm mb-2">مدة التسجيل اليومية</h4>
                                                    <span className="text-2xl font-bold">{currentControlledCamera.storage?.dailyHours}</span>
                                                    <span className="text-sm text-gray-500 mr-2">ساعة / يوم</span>
                                                </div>
                                                <div className="bg-slate-800/50 p-6 rounded-xl border border-indigo-500/20 text-center">
                                                    <div className="mx-auto text-indigo-400 mb-2 flex justify-center"><Icon name="Activity" size={32}/></div>
                                                    <h4 className="text-slate-400 text-sm mb-2">مدة الاحتفاظ</h4>
                                                    <span className="text-2xl font-bold">{currentControlledCamera.storage?.retentionDays}</span>
                                                    <span className="text-sm text-gray-500 mr-2">يوم / شهر</span>
                                                </div>
                                            </div>
                                        </div>}
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}

                    {/* Header */}
                    <header className="bg-slate-950/50 backdrop-blur-md border-b border-indigo-500/20 p-6 flex justify-between items-center sticky top-0 z-50 shadow-xl">
                        <div className="flex items-center gap-4">
                            <div className="w-12 h-12 bg-gradient-to-br from-indigo-600 to-blue-600 rounded-xl flex items-center justify-center shadow-lg"><Icon name="Cctv" className="text-white" size={28}/></div>
                            <div>
                                <h1 className="text-2xl font-black tracking-wide text-white">غرفة المراقبة و التحكم</h1>
                                <p className="text-xs text-indigo-300 flex items-center gap-2 font-bold"><span className={`w-2 h-2 rounded-full ${isAdmin ? 'bg-yellow-500' : 'bg-indigo-500'} animate-pulse`}></span>{isAdmin ? 'مدير النظام' : `مرحباً، ${currentUser.name}`}</p>
                            </div>
                        </div>
                        <div className="flex items-center gap-3">
                            {isAdmin && <button className="h-[42px] flex items-center gap-2 text-xs bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 px-4 rounded-xl border border-indigo-500/50 transition-colors font-black"><Icon name="UserCog" size={16}/> إدارة</button>}
                            <button onClick={handleLogout} className="text-slate-400 hover:text-red-400 text-xs px-2 transition-colors"><Icon name="Lock" size={14}/></button>
                            <div className="bg-slate-900/50 px-4 h-[42px] rounded-xl border border-indigo-500/20 flex items-center gap-2">
                                <Icon name="Clock" size={16} className="text-slate-400"/>
                                <span className="text-lg font-bold">{currentTime.toLocaleTimeString('en-US', {hour12:false})}</span>
                            </div>
                        </div>
                    </header>

                    {/* Main Content */}
                    <main className="p-8 flex-grow max-w-full">
                        {!selectedScreenId ? (
                            <div className="space-y-8">
                                <div className="flex justify-between items-center">
                                    <div><h2 className="text-2xl font-black text-indigo-300 border-l-4 border-indigo-500 pl-4 inline-block">نظرة عامة على شاشات المراقبة</h2></div>
                                    {isAdmin && <button onClick={addNewScreen} className="accent-btn text-white px-6 py-3 rounded-xl flex items-center gap-2 shadow-2xl text-sm font-black"><Icon name="Plus" size={20}/> <span>إضافة شاشة</span></button>}
                                </div>
                                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                                    {screens.map((screen) => (
                                        <button 
                                            key={screen.id} 
                                            onClick={() => setSelectedScreenId(screen.id)} 
                                            className="stat-card group relative bg-slate-900/40 hover:bg-slate-800/50 text-right flex flex-col gap-4 hover:-translate-y-1 transition-all"
                                        >
                                            <div className="flex justify-between items-start">
                                                <div className="bg-indigo-600/20 w-14 h-14 rounded-2xl flex items-center justify-center font-black text-2xl text-indigo-300 group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-lg"><Icon name="Cctv" size={24}/></div>
                                                <div className={`px-2 py-1 rounded-lg border text-[10px] font-black ${screen.status === 'active' ? 'border-green-500/30 text-green-400 bg-green-500/10' : 'border-red-500/30 text-red-400 bg-red-500/10'}`}>
                                                    {screen.status === 'active' ? '🟢 ONLINE' : '🔴 OFFLINE'}
                                                </div>
                                            </div>
                                            <h3 className="font-black text-lg text-white group-hover:text-indigo-300 transition-colors">{screen.name}</h3>
                                            <div className="w-full h-px bg-indigo-500/10"></div>
                                            <div className="flex justify-between items-center w-full text-xs text-slate-400 font-bold">
                                                <span>{screen.cameras.length} كاميرات</span>
                                            </div>
                                        </button>
                                    ))}
                                </div>
                            </div>
                        ) : (
                            <div className="animate-in fade-in zoom-in duration-300">
                                <div className="flex justify-between items-center mb-8">
                                    <button onClick={handleBack} className="flex items-center gap-2 text-slate-400 hover:text-white transition-colors group px-4 py-2 rounded-lg hover:bg-slate-800 font-bold"><Icon name="ArrowRight" size={20}/> <span>العودة</span></button>
                                    {isAdmin && <button onClick={() => setIsEditMode(!isEditMode)} className={`flex items-center gap-2 px-8 py-3 rounded-xl border font-black transition-all ${isEditMode ? 'bg-indigo-600 border-indigo-600 shadow-lg shadow-indigo-600/30' : 'bg-slate-900/50 border-indigo-500/20 hover:border-indigo-500/50'}`}><Icon name={isEditMode ? "Save" : "Settings"} size={18}/> <span>{isEditMode ? 'حفظ' : 'تعديل'}</span></button>}
                                </div>

                                {activeScreen && (
                                    <div className="bg-slate-900/50 border border-indigo-500/20 rounded-3xl overflow-hidden shadow-2xl">
                                        <div className="bg-gradient-to-r from-slate-900 to-slate-900/50 p-10 border-b border-indigo-500/20">
                                            <div className="flex justify-between items-start">
                                                <div>
                                                    <h2 className="text-4xl font-black text-white mb-2">{activeScreen.name}</h2>
                                                    <p className="text-indigo-400 font-bold flex items-center gap-2"><Icon name="Cctv" size={18}/> شاشة رئيسية {activeScreen.charId}</p>
                                                </div>
                                                <div className={`px-6 py-3 rounded-2xl border-2 flex items-center gap-3 font-black ${activeScreen.status === 'active' ? 'bg-green-500/10 border-green-500/30 text-green-400' : 'bg-red-500/10 border-red-500/30 text-red-400'}`}>
                                                    <div className={`w-3 h-3 rounded-full ${activeScreen.status === 'active' ? 'bg-green-500' : 'bg-red-500'} animate-pulse`}></div>
                                                    {activeScreen.status === 'active' ? '🟢 LIVE' : '🔴 OFFLINE'}
                                                </div>
                                            </div>
                                        </div>

                                        <div className="p-10">
                                            {isEditMode && <div className="mb-8 bg-indigo-500/10 p-6 rounded-2xl border border-indigo-500/20"><p className="text-sm text-indigo-300 font-black flex items-center gap-3"><Icon name="Edit3" size={20}/> وضع التعديل مفعّل</p></div>}
                                            
                                            <div className="grid grid-cols-1 xl:grid-cols-2 gap-8">
                                                {activeScreen.cameras.map((cam) => (
                                                    <div key={cam.id} className="bg-slate-800/30 border border-indigo-500/10 rounded-3xl p-6 flex flex-col sm:flex-row gap-6 hover:border-indigo-500/30 transition-all">
                                                        <div className="w-full sm:w-56 flex-shrink-0"><VideoPlaceholder id={cam.id} code={cam.code} status={cam.status} /></div>
                                                        <div className="flex-1 flex flex-col justify-between">
                                                            <div>
                                                                <h3 className="text-xl font-black text-white mb-3">{cam.name}</h3>
                                                                <button onClick={() => setSelectedCameraForControl({ screenId: activeScreen.id, camera: cam })} className="w-full bg-indigo-600/20 hover:bg-indigo-600/40 text-indigo-300 border border-indigo-500/30 rounded-xl py-3 text-xs font-black flex items-center justify-center gap-2 transition-all mb-4"><Icon name="Settings" size={16}/> إدارة البيانات</button>
                                                            </div>
                                                            <div className={`pt-3 border-t border-indigo-500/10 flex gap-2 ${isEditMode ? 'flex' : 'hidden'}`}>
                                                                <button className="flex-1 h-8 rounded-lg flex items-center justify-center bg-green-600/20 text-green-400 hover:bg-green-600/40 transition-all"><Icon name="CheckCircle" size={16}/></button>
                                                                <button className="flex-1 h-8 rounded-lg flex items-center justify-center bg-slate-700 hover:bg-slate-600 transition-all"><Icon name="AlertTriangle" size={16}/></button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </div>
                        )}
                    </main>

                    {/* Footer */}
                    <footer className="bg-slate-950/50 border-t border-indigo-500/20 py-6 px-10 mt-auto w-full">
                        <div className="flex justify-between items-center text-[11px] font-black text-slate-500 uppercase">
                            <span>CCTV Monitoring System v2.0</span>
                            <span>✓ الأمن و السلامة - 2025</span>
                        </div>
                    </footer>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<SecurityDashboard />);
    </script>
</body>
</html>