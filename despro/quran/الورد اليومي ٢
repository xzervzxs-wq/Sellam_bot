  );

  const HomeView = () => (
    <div className="flex flex-col h-full p-6 animate-fade-in bg-[#FDFBF7]" dir="rtl">
      <div className="flex justify-between items-center mb-10 pt-4">
        <div className="flex items-center gap-4">
            <div className="w-14 h-14 bg-gradient-to-br from-[#1A4D2E] to-[#0F2E1B] rounded-2xl flex items-center justify-center rotate-3 shadow-lg border border-[#D4AF37]/30">
                <Moon className="w-7 h-7 text-[#D4AF37] fill-[#D4AF37]" />
            </div>
            <div>
                <h1 className="text-2xl font-black text-[#1A4D2E] font-cairo leading-none mb-1">وِردُك اليومي</h1>
                <p className="text-[#8C8A84] text-xs font-semibold font-cairo tracking-wide">
                  {new Date().toLocaleDateString('ar-SA', { weekday: 'long', month: 'long', day: 'numeric' })}
                </p>
            </div>
        </div>
        <button 
            onClick={() => setIsSettingsOpen(true)}
            className="w-12 h-12 rounded-2xl border border-[#D4AF37]/30 bg-white flex items-center justify-center hover:bg-[#FDFBF7] active:scale-95 transition shadow-sm text-[#D4AF37]"
        >
          <Settings className="w-6 h-6" />
        </button>
      </div>

      <div className="bg-[#1A4D2E] rounded-[32px] p-1 text-white shadow-xl shadow-[#1A4D2E]/20 mb-10 relative overflow-hidden group cursor-default transition-transform hover:scale-[1.02]">
        <div className="bg-gradient-to-br from-[#1A4D2E] to-[#0D2916] rounded-[28px] p-7 h-full relative z-10 border border-[#ffffff]/10">
          <div className="absolute top-0 left-0 w-full h-full opacity-10 bg-[url('https://www.transparenttextures.com/patterns/arabesque.png')]"></div>
          <div className="relative z-10 flex justify-between items-center">
            <div>
              <div className="flex items-center gap-2 mb-2">
                <Star className="w-4 h-4 text-[#D4AF37] fill-[#D4AF37]" />
                <p className="text-[#D4AF37] text-sm font-cairo font-bold tracking-wide">إنجاز متواصل</p>
                <button 
                  onClick={(e) => { e.stopPropagation(); setIsHistoryOpen(true); }}
                  className="mr-2 p-1 bg-[#D4AF37]/20 rounded-full hover:bg-[#D4AF37]/40 transition-colors"
                  title="سجل الإنجازات"
                >
                  <History className="w-3 h-3 text-[#D4AF37]" />
                </button>
              </div>
              <div className="flex items-baseline gap-2">
                <span className="text-5xl font-black font-cairo tracking-tight text-white">{streak}</span>
                <span className="text-lg opacity-80 font-cairo text-[#E8E6E1]">يوماً</span>
              </div>
            </div>
            <div className="w-16 h-16 bg-[#D4AF37]/20 rounded-2xl flex items-center justify-center backdrop-blur-md border border-[#D4AF37]/30">
              <Flame className="w-8 h-8 text-[#D4AF37] fill-[#D4AF37]" />
            </div>
          </div>
        </div>
      </div>

      <div className="flex-1 flex flex-col items-center justify-center relative">
        <div className="relative w-64 h-64 flex items-center justify-center mb-12">
          <div className="absolute inset-0 bg-[#D4AF37]/5 rounded-full blur-xl"></div>
          <svg className="w-full h-full transform -rotate-90 drop-shadow-2xl">
            <circle cx="128" cy="128" r="100" stroke="#E8E6E1" strokeWidth="12" fill="none" />
            <circle 
              cx="128" cy="128" r="100" 
              stroke="#D4AF37" 
              strokeWidth="12" 
              fill="none" 
              strokeDasharray={2 * Math.PI * 100}
              strokeDashoffset={2 * Math.PI * 100 * (1 - pagesReadToday/dailyGoal)}
              className="transition-all duration-1000 ease-out"
              strokeLinecap="round"
            />
          </svg>
          <div className="absolute flex flex-col items-center">
            <span className="text-6xl font-black text-[#1A4D2E] font-cairo">{pagesReadToday}</span>
            <span className="text-[#8C8A84] text-sm font-bold mt-2 font-cairo tracking-wide bg-white/50 px-3 py-1 rounded-full border border-[#D4AF37]/20">
              {pagesReadToday} / {dailyGoal}
            </span>
          </div>
        </div>
        <button 
          onClick={() => setCurrentView('reading')}
          className="w-full bg-[#1A4D2E] text-white py-5 rounded-2xl font-bold text-xl shadow-xl shadow-[#1A4D2E]/30 active:scale-[0.98] transition-all flex items-center justify-center gap-3 font-cairo border border-[#D4AF37]/30 hover:bg-[#143d24] relative overflow-hidden"
        >
          <span className="absolute top-0 right-0 w-20 h-full bg-gradient-to-l from-[#ffffff]/10 to-transparent"></span>
          <BookOpen className="w-6 h-6 text-[#D4AF37]" />
          <span className="relative z-10">{pagesReadToday > 0 ? 'متابعة الورد' : 'ابدأ القراءة'}</span>
        </button>
      </div>
    </div>
  );

  const ReadingView = () => {
    const handleNext = () => {
      if (currentPageNum < 604) {
        const nextPage = currentPageNum + 1;
        const nextPagesRead = pagesReadToday + 1;
        
        if (nextPagesRead === dailyGoal) {
          handleGoalReached();
        }
        
        setCurrentPageNum(nextPage);
        setPagesReadToday(nextPagesRead);
      } else {
        setPagesReadToday(dailyGoal);
        setCurrentView('completed');
      }
    };

    const handlePrev = () => {
      if (currentPageNum > 1) {
        setCurrentPageNum(prev => prev - 1);
      }
    };

    const currentMutashabih = MUTASHABIH_DB[currentPageNum];

    return (
      <div className="flex flex-col h-full bg-[#FDFBF7]" dir="rtl">
        <div className="px-6 py-5 flex justify-between items-center border-b border-[#D4AF37]/20 bg-[#FDFBF7]/90 backdrop-blur-md sticky top-0 z-20">
          <button onClick={() => setCurrentView('home')} className="p-2 rounded-full hover:bg-[#E8E6E1] active:scale-90 transition">
            <ArrowLeft className="w-6 h-6 text-[#1A4D2E] rotate-180" />
          </button>
          <div className="text-center">
            {isLoading ? (
               <div className="h-6 w-24 bg-[#E8E6E1] animate-pulse rounded"></div>
            ) : (
               <h2 className="text-[#1A4D2E] font-bold font-cairo text-lg">{headerTitle}</h2>
            )}
            <div className="flex items-center justify-center gap-2 mt-1">
               <span className="h-[1px] w-8 bg-[#D4AF37]/40"></span>
               <p className="text-xs text-[#D4AF37] font-bold font-cairo">صفحة {toArabicNumerals(currentPageNum)}</p>
               <span className="h-[1px] w-8 bg-[#D4AF37]/40"></span>
            </div>
          </div>
          <div className="w-10"></div>
        </div>

        <div className="flex-1 overflow-y-auto p-4 sm:p-6 flex flex-col items-center relative">
          <div className="w-full max-w-lg min-h-[500px] h-auto mb-10 px-2 sm:px-0">
             <div className="w-full h-full flex flex-col items-center py-4 relative min-h-[480px]">
                <div className="text-center w-full relative z-10 flex-1 flex flex-col items-center">
                    {isLoading && (
                      <div className="flex flex-col items-center gap-4 mt-20">
                        <Loader2 className="w-10 h-10 text-[#D4AF37] animate-spin" />
                        <p className="text-[#8C8A84] font-cairo text-sm">جاري جلب الآيات...</p>
                      </div>
                    )}
                    {error && (
                      <div className="flex flex-col items-center gap-4 text-red-800 bg-red-50 p-6 rounded-2xl border border-red-100 mt-20">
                        <WifiOff className="w-8 h-8 opacity-50" />
                        <p className="font-cairo font-bold">{error}</p>
                        <button onClick={() => fetchPageData(currentPageNum)} className="text-sm underline">إعادة المحاولة</button>
                      </div>
                    )}
                    {!isLoading && !error && (
                      <div className="font-amiri text-2xl md:text-4xl text-[#1A1A1A] leading-[2.8] text-justify tracking-wide selection:bg-[#D4AF37]/20 w-full pb-8" dir="rtl">
                        {pageVerses.map((verse) => {
                          const verseNum = verse.verse_key.split(':')[1];
                          const surahId = verse.verse_key.split(':')[0];
                          return (
                            <React.Fragment key={verse.id}>
                              {verseNum === '1' && <SurahHeader surahId={surahId} />}
                              <span className="inline">
                                {verse.text_uthmani} <VerseMarker number={verseNum} />
                              </span>
                            </React.Fragment>
                          );
                        })}
                      </div>
                    )}
                </div>
             </div>
          </div>
          {currentMutashabih && !isLoading && (
            <div className="mt-8 w-full max-w-md animate-slide-up mb-6">
              <button 
                onClick={() => setShowMutashabih(!showMutashabih)}
                className={`flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold transition-all mx-auto shadow-sm font-cairo border
                  ${showMutashabih 
                    ? 'bg-[#FEF9E7] text-[#B58D1D] border-[#D4AF37]/40' 
                    : 'bg-white text-[#8C8A84] border-[#E8E6E1] hover:border-[#D4AF37]/40'}`}
              >
                <Info className="w-4 h-4" />
                {showMutashabih ? 'إخفاء التوجيه' : 'تنبيه متشابه'}
              </button>
              {showMutashabih && (
                <div className="mt-4 p-5 bg-[#FEF9E7] border border-[#D4AF37]/20 rounded-2xl text-center text-[#5C5A54] text-sm shadow-md animate-fade-in relative font-cairo leading-relaxed">
                   <div className="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 bg-[#FEF9E7] border-t border-l border-[#D4AF37]/20 rotate-45"></div>
                   <p><strong className="text-[#B58D1D]">فائدة: </strong>{currentMutashabih}</p>
                </div>
              )}
            </div>
          )}
        </div>

        <div className="p-5 bg-white border-t border-[#E8E6E1] pb-8 sm:pb-5 shadow-[0_-4px_20px_-5px_rgba(0,0,0,0.05)]">
          <div className="flex justify-between items-center max-w-md mx-auto" dir="ltr">
             <button 
              onClick={handlePrev}
              disabled={currentPageNum === 1 || isLoading}
              className="w-14 h-14 flex items-center justify-center rounded-2xl text-[#8C8A84] disabled:opacity-30 hover:bg-[#FDFBF7] border border-transparent hover:border-[#D4AF37]/20 transition"
            >
              <ChevronRight className="w-6 h-6" />
            </button>
            <div className="flex flex-col items-center gap-2 w-full px-6">
              <span className="text-xs text-[#D4AF37] font-bold font-cairo tracking-widest">{pagesReadToday} / {dailyGoal} من الورد</span>
              <div className="h-2 w-full bg-[#E8E6E1] rounded-full overflow-hidden" dir="rtl">
                <div 
                  className="h-full bg-[#D4AF37] transition-all duration-500 ease-out rounded-full shadow-[0_0_10px_rgba(212,175,55,0.5)]"
                  style={{ width: `${Math.min((pagesReadToday / dailyGoal) * 100, 100)}%` }}
                ></div>
              </div>
            </div>
            <button 
              onClick={handleNext}
              disabled={isLoading}
              className="w-14 h-14 flex items-center justify-center rounded-2xl bg-[#1A4D2E] text-[#D4AF37] shadow-lg shadow-[#1A4D2E]/20 active:scale-95 transition hover:bg-[#143d24] border border-[#D4AF37]/30"
            >
              <ChevronLeft className="w-6 h-6" />
            </button>
          </div>
        </div>
      </div>
    );
  };

  const CompletedView = () => (
    <div className="flex flex-col h-full items-center justify-center p-8 bg-[#1A4D2E] text-white text-center animate-fade-in relative overflow-hidden" dir="rtl">
      <div className="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/arabesque.png')]"></div>
      <div className="absolute -top-20 -right-20 w-64 h-64 bg-[#D4AF37]/20 rounded-full blur-3xl"></div>
      <div className="absolute -bottom-20 -left-20 w-64 h-64 bg-[#D4AF37]/10 rounded-full blur-3xl"></div>
      <div className="relative z-10 flex flex-col items-center w-full max-w-md">
        <div className="w-32 h-32 bg-white/5 rounded-[30px] rotate-6 flex items-center justify-center mb-10 animate-bounce-slow backdrop-blur-md border border-[#D4AF37]/30 shadow-2xl">
          <CheckCircle className="w-16 h-16 text-[#D4AF37] -rotate-6" />
        </div>
        <h2 className="text-4xl font-black font-cairo mb-3 text-white">فتح الله عليك</h2>
        <p className="text-[#E8E6E1] mb-12 text-lg font-cairo opacity-90">أتممت وردك اليومي بنجاح وتقبل الله منك</p>
        <div className="bg-[#0F2E1B]/50 backdrop-blur-md rounded-[24px] p-6 w-full mb-8 border border-[#D4AF37]/20 shadow-xl">
          <div className="flex justify-between items-center mb-4 border-b border-[#ffffff]/10 pb-4">
            <span className="text-[#E8E6E1] font-cairo">الصفحات المنجزة</span>
            <span className="font-bold text-2xl font-cairo text-[#D4AF37]">{pagesReadToday}</span>
          </div>
          <div className="flex justify-between items-center">
            <span className="text-[#E8E6E1] font-cairo">الوقت المستغرق</span>
            <span className="font-bold text-2xl font-cairo text-[#D4AF37]">12 دقيقة</span>
          </div>
        </div>
        <div className="flex gap-4 w-full">
          <button 
            onClick={() => { setPagesReadToday(0); setCurrentView('home'); }}
            className="flex-1 bg-[#FDFBF7] text-[#1A4D2E] py-4 rounded-2xl font-bold font-cairo hover:bg-[#E8E6E1] active:scale-95 transition shadow-lg border border-[#D4AF37]"
          >
            العودة للرئيسية
          </button>
          <button className="p-4 bg-[#D4AF37]/20 rounded-2xl hover:bg-[#D4AF37]/30 active:scale-95 transition border border-[#D4AF37]/40 backdrop-blur-sm text-[#D4AF37]">
            <Share2 className="w-6 h-6" />
          </button>
        </div>
      </div>
    </div>
  );

  return (
    <div className="flex justify-center items-center min-h-screen bg-[#E0DCD5] font-sans">
      <div className="w-full max-w-md h-[850px] bg-[#FDFBF7] shadow-2xl overflow-hidden relative rounded-none sm:rounded-[40px] border-[#D4AF37]/20 sm:border-[8px] flex flex-col">
        
        <style>
          {`
            @import url('https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@300;400;500;700;800;900&display=swap');
            
            .font-amiri { font-family: 'Amiri', serif; }
            .font-cairo { font-family: 'Cairo', sans-serif; }
            body { font-family: 'Cairo', sans-serif; } 
            
            .animate-fade-in { animation: fadeIn 0.5s ease-out; }
            .animate-slide-up { animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
            .animate-bounce-slow { animation: float 6s ease-in-out infinite; }
            .animate-spin { animation: spin 1s linear infinite; }
            
            @keyframes fadeIn {
              from { opacity: 0; }
              to { opacity: 1; }
            }
            @keyframes slideUp {
              from { opacity: 0; transform: translateY(30px); }
              to { opacity: 1; transform: translateY(0); }
            }
            @keyframes float {
              0% { transform: translateY(0px) rotate(6deg); }
              50% { transform: translateY(-12px) rotate(6deg); }
              100% { transform: translateY(0px) rotate(6deg); }
            }
            @keyframes spin {
              from { transform: rotate(0deg); }
              to { transform: rotate(360deg); }
            }
          `}
        </style>

        {/* Content Area */}
        <div className="flex-1 overflow-hidden relative">
            {activeTab === 'wird' && (
                currentView === 'home' ? <HomeView /> : 
                currentView === 'reading' ? <ReadingView /> : 
                <CompletedView />
            )}
            {activeTab === 'mushaf' && <MushafView />}
            {activeTab === 'designer' && <DesignerView />}
        </div>

        {/* Bottom Navigation Bar - Refined Design */}
        <div className="bg-white border-t border-[#E8E6E1] px-10 py-3 flex justify-between items-center shadow-[0_-10px_30px_-15px_rgba(0,0,0,0.05)] z-30 rounded-t-3xl relative" dir="rtl">
            
            {/* Mushaf (Right) */}
            <button 
                onClick={() => setActiveTab('mushaf')}
                className={`group flex flex-col items-center gap-1.5 transition-all w-16 ${activeTab === 'mushaf' ? 'text-[#1A4D2E]' : 'text-[#8C8A84] hover:text-[#1A4D2E]/70'}`}
            >
                <div className="relative">
                    <Book className={`w-6 h-6 transition-transform duration-300 ${activeTab === 'mushaf' ? '-translate-y-1' : ''}`} strokeWidth={activeTab === 'mushaf' ? 2.5 : 2} />
                    {activeTab === 'mushaf' && <span className="absolute -bottom-3 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-[#D4AF37] rounded-full animate-fade-in"></span>}
                </div>
                <span className={`text-[11px] font-bold font-cairo transition-all ${activeTab === 'mushaf' ? 'opacity-100' : 'opacity-0 h-0 overflow-hidden'}`}>المصحف</span>
            </button>

            {/* Daily Wird (Center - Main) */}
            <button 
                onClick={() => setActiveTab('wird')}
                className={`group flex flex-col items-center gap-1.5 transition-all w-16 ${activeTab === 'wird' ? 'text-[#1A4D2E]' : 'text-[#8C8A84] hover:text-[#1A4D2E]/70'}`}
            >
                <div className="relative">
                    <Moon className={`w-6 h-6 transition-transform duration-300 ${activeTab === 'wird' ? '-translate-y-1 fill-current' : ''}`} strokeWidth={activeTab === 'wird' ? 2.5 : 2} />
                    {activeTab === 'wird' && <span className="absolute -bottom-3 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-[#D4AF37] rounded-full animate-fade-in"></span>}
                </div>
                <span className={`text-[11px] font-bold font-cairo transition-all ${activeTab === 'wird' ? 'opacity-100' : 'opacity-0 h-0 overflow-hidden'}`}>الورد</span>
            </button>

            {/* Designer (Left) */}
            <button 
                onClick={() => setActiveTab('designer')}
                className={`group flex flex-col items-center gap-1.5 transition-all w-16 ${activeTab === 'designer' ? 'text-[#1A4D2E]' : 'text-[#8C8A84] hover:text-[#1A4D2E]/70'}`}
            >
                <div className="relative">
                    <Palette className={`w-6 h-6 transition-transform duration-300 ${activeTab === 'designer' ? '-translate-y-1' : ''}`} strokeWidth={activeTab === 'designer' ? 2.5 : 2} />
                    {activeTab === 'designer' && <span className="absolute -bottom-3 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-[#D4AF37] rounded-full animate-fade-in"></span>}
                </div>
                <span className={`text-[11px] font-bold font-cairo transition-all ${activeTab === 'designer' ? 'opacity-100' : 'opacity-0 h-0 overflow-hidden'}`}>المصمم</span>
            </button>
        </div>
        
        {/* Modals */}
        {isSettingsOpen && <SettingsModal />}
        {isHistoryOpen && <HistoryModal />}
        {isGoalReachedModalOpen && <GoalReachedModal />}

      </div>
    </div>
  );
}