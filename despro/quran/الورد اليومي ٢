  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState(null);

  // --- حفظ البيانات عند التغيير ---
  useEffect(() => { localStorage.setItem('wird_dailyGoal', dailyGoal); }, [dailyGoal]);
  useEffect(() => { localStorage.setItem('wird_currentPage', currentPageNum); }, [currentPageNum]);
  useEffect(() => { localStorage.setItem('wird_streak', streak); }, [streak]);
  useEffect(() => { localStorage.setItem('wird_startPage', startPageGoal); }, [startPageGoal]);
  useEffect(() => { localStorage.setItem('wird_lastReadDate', lastReadDate); }, [lastReadDate]);
  useEffect(() => { localStorage.setItem('wird_history', JSON.stringify(achievementLog)); }, [achievementLog]);

  const toArabicNumerals = (num) => num.toString().replace(/\d/g, d => "٠١٢٣٤٥٦٧٨٩"[d]);

  const cacheNextPages = async (startPage) => {
    for (let i = 1; i <= 20; i++) {
      const targetPage = startPage + i;
      if (targetPage > 604) break;
      const cacheKey = `quran_page_${targetPage}`;
      if (localStorage.getItem(cacheKey)) continue;
      try {
        const response = await fetch(`https://api.quran.com/api/v4/quran/verses/uthmani?page_number=${targetPage}`);
        if (response.ok) {
          const data = await response.json();
          localStorage.setItem(cacheKey, JSON.stringify(data));
        }
      } catch (e) { console.log("Caching failed for page", targetPage); }
    }
  };

  const fetchPageData = async (pageNum) => {
    setIsLoading(true);
    setError(null);
    setShowMutashabih(false);

    const cacheKey = `quran_page_${pageNum}`;
    const cachedData = localStorage.getItem(cacheKey);

    if (cachedData) {
      processData(JSON.parse(cachedData));
      setIsLoading(false);
      cacheNextPages(pageNum);
      return;
    }

    try {
      const response = await fetch(`https://api.quran.com/api/v4/quran/verses/uthmani?page_number=${pageNum}`);
      if (!response.ok) throw new Error("فشل الاتصال بالخادم");
      
      const data = await response.json();
      try { localStorage.setItem(cacheKey, JSON.stringify(data)); } catch (e) {}

      processData(data);
      cacheNextPages(pageNum);

    } catch (err) {
      console.error(err);
      setError("تأكد من اتصالك بالإنترنت");
    } finally {
      setIsLoading(false);
    }
  };

  const processData = (data) => {
    setPageVerses(data.verses);
    const startingSurahVerse = data.verses.find(v => v.verse_key.split(':')[1] === '1');
    if (startingSurahVerse) {
      const surahId = startingSurahVerse.verse_key.split(':')[0];
      setHeaderTitle(SURAH_DATA[surahId]?.name);
    } else {
      const firstVerseKey = data.verses[0].verse_key;
      const chapterId = firstVerseKey.split(':')[0];
      setHeaderTitle(SURAH_DATA[chapterId]?.name);
    }
  }

