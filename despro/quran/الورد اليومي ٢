            >
              حفظ التغييرات
            </button>
          </div>
        </div>
      </div>
    );
  };

  const HistoryModal = () => (
    <div className="absolute inset-0 z-50 flex items-end sm:items-center justify-center bg-black/60 backdrop-blur-sm animate-fade-in" dir="rtl">
