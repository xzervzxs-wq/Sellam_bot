        };

        const Icon = ({ name, size = 24, className = "" }) => {
            const pathData = ICONS_DATA[name];
            if (!pathData) return null;
            return (
                <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d={pathData} /></svg>
            );
        };
        const getIcon = (name, props = {}) => <Icon name={name} {...props} />;

        const SignaturePad = ({ onSave, onClear }) => {
            const canvasRef = useRef(null);
            const [isDrawing, setIsDrawing] = useState(false);
            useEffect(() => {
                const canvas = canvasRef.current;
                const resize = () => {
                    const rect = canvas.getBoundingClientRect();
                    canvas.width = rect.width; canvas.height = rect.height;
                    const ctx = canvas.getContext('2d');
                    ctx.lineWidth = 2; ctx.lineCap = 'round';
                    ctx.strokeStyle = document.documentElement.classList.contains('dark') ? 'white' : '#000000';
                };
                resize(); window.addEventListener('resize', resize);
                return () => window.removeEventListener('resize', resize);
            }, []);
            const getCoords = (e) => { const r = canvasRef.current.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
            const start = (e) => { const {x,y} = getCoords(e.nativeEvent); const ctx = canvasRef.current.getContext('2d'); ctx.beginPath(); ctx.moveTo(x,y); setIsDrawing(true); };
            const draw = (e) => { if(!isDrawing)return; const {x,y} = getCoords(e.nativeEvent); const ctx = canvasRef.current.getContext('2d'); ctx.lineTo(x,y); ctx.stroke(); };
            const stop = () => { if(isDrawing) { canvasRef.current.getContext('2d').closePath(); setIsDrawing(false); } };
            return (
                <div className="flex flex-col gap-2">
                    <div className="border border-gray-600 bg-white dark:bg-gray-800 rounded h-40 w-full shadow-inner overflow-hidden cursor-crosshair">
                        <canvas ref={canvasRef} onMouseDown={start} onMouseMove={draw} onMouseUp={stop} onMouseLeave={stop} className="w-full h-full block"/>
                    </div>
                    <div className="flex gap-2 text-xs">
                        <button type="button" onClick={() => onSave(canvasRef.current.toDataURL())} className="bg-blue-600 px-3 py-1 rounded text-white hover:bg-blue-500 font-bold">تأكيد التوقيع</button>
                        <button type="button" onClick={() => { const ctx = canvasRef.current.getContext('2d'); ctx.clearRect(0,0,canvasRef.current.width,canvasRef.current.height); onClear(); }} className="bg-gray-300 dark:bg-gray-600 text-gray-900 dark:text-white px-3 py-1 rounded hover:bg-gray-400 font-bold">مسح</button>
                    </div>
                </div>
            );
        };

        const INITIAL_SCREENS = Array.from({ length: 12 }, (_, i) => ({
            id: i + 1, charId: String.fromCharCode(65 + i), name: `شاشة العرض ${i + 1}`, status: 'active', statusReason: '', 
            cameras: Array.from({ length: 10 }, (_, j) => ({
                id: `${i + 1}-${j + 1}`, number: j + 1, name: `كاميرا ${j + 1}`, code: `CAM-${i + 1}-${j + 1}`, status: 'active', note: '', lastUpdate: '10:00',
                storage: { dailyHours: '24', retentionDays: '30' }, incidents: [], inspections: [], recordings: [], maintenance: []
            }))
        }));
        const INITIAL_USERS = [{ id: 1, name: 'Admin', code: '1234', role: 'admin' }];
        const INITIAL_EXTERNAL = [];
        const INITIAL_POLICIES = [];

        const VideoPlaceholder = ({ id, code, status }) => {
            let borderColor = 'border-gray-300 dark:border-gray-800';
            let statusText = '', statusColor = 'text-gray-600 dark:text-gray-500';
            if(status==='active'){ borderColor='border-green-500/50'; statusText='● LIVE'; statusColor='text-green-600 dark:text-green-500'; }
            else if(status==='error'){ borderColor='border-red-500/50'; statusText='○ OFFLINE'; statusColor='text-red-600 dark:text-red-500'; }
            else if(status==='warning'){ borderColor='border-orange-500/50'; statusText='⚠ DISABLED'; statusColor='text-orange-600 dark:text-orange-500'; }
            return (
                <div className={`relative w-full h-32 bg-slate-200 dark:bg-gray-900 rounded-md overflow-hidden border-2 ${borderColor} group transition-all duration-300 shadow-inner`}>
                    <div className="absolute inset-0 flex items-center justify-center text-gray-500 dark:text-gray-700 group-hover:text-gray-700 dark:group-hover:text-gray-600 transition-colors">{getIcon('Video', {size:32})}</div>
                    <div className={`absolute top-2 left-2 text-xs font-bold font-mono ${statusColor} ${status==='active'?'animate-pulse':''}`}>{statusText}</div>
                    <div className="absolute bottom-2 right-2 text-xs text-gray-700 dark:text-gray-500 font-bold font-mono bg-white/90 dark:bg-black/50 px-1 rounded shadow-sm">{code || `CAM-${id}`}</div>
                    <div className="absolute inset-0 bg-gradient-to-b from-transparent to-black/5 pointer-events-none"></div>
                </div>
            );
        };

        function SecurityDashboard() {
            const [theme, setTheme] = useState('dark');
            useEffect(() => { document.documentElement.classList.toggle('dark', theme === 'dark'); }, [theme]);
            const toggleTheme = () => setTheme(prev => prev === 'dark' ? 'light' : 'dark');

            const load = (k, d) => { try { const s = localStorage.getItem(k); return s ? JSON.parse(s) : d; } catch { return d; } };
            // --- تم تغيير مفاتيح الحفظ (v2) لإجبار المتصفح على تحميل بيانات جديدة ونظيفة ---
            const [users, setUsers] = useState(() => load('cctv_users_v2', INITIAL_USERS));
            const [externalDepts, setExternalDepts] = useState(() => load('cctv_external_v2', INITIAL_EXTERNAL));
            const [policyFiles, setPolicyFiles] = useState(() => load('cctv_policies_v2', INITIAL_POLICIES));
            const [screens, setScreens] = useState(() => load('cctv_screens_v2', INITIAL_SCREENS));
            
            const [currentUser, setCurrentUser] = useState(null);
            const [accessCode, setAccessCode] = useState('');
            const [loginError, setLoginError] = useState(false);
            const [showAdminPanel, setShowAdminPanel] = useState(false);
            const [showExternalPanel, setShowExternalPanel] = useState(false);
            const [showPolicyPanel, setShowPolicyPanel] = useState(false);
            const [selectedCameraForControl, setSelectedCameraForControl] = useState(null);
            const [activeControlTab, setActiveControlTab] = useState('storage');
            const [selectedScreenId, setSelectedScreenId] = useState(null);
            const [currentTime, setCurrentTime] = useState(new Date());
            const [isEditMode, setIsEditMode] = useState(false);
            
            const [deleteModal, setDeleteModal] = useState({ isOpen: false, type: null, id: null, secId: null, title: '', message: '' });
            const [editingItem, setEditingItem] = useState(null);
            const [incidentForm, setIncidentForm] = useState({ section: '', reporter: '', action: '', employee: '' });
            const [inspectionForm, setInspectionForm] = useState({ imageQuality: true, recordingStatus: true, lensClean: true, timeSync: true, notes: '' });
            const [maintenanceForm, setMaintenanceForm] = useState({ action: '', technician: '' });
            const [recordingForm, setRecordingForm] = useState({ recNum: '', reason: '', entity: '', signature: null });
            const [newExternal, setNewExternal] = useState({ deptName: '', camCount: '', storage: '', manager: '', phone: '' });
            const [adminNewCode, setAdminNewCode] = useState('');
            const [newUser, setNewUser] = useState({ name: '', code: '', role: 'viewer' });
            const [userEditModal, setUserEditModal] = useState({ isOpen: false, user: null });
            const [viewingFile, setViewingFile] = useState(null);
            const fileInputRef = useRef(null);
            const pdfInputRef = useRef(null);

            useEffect(() => { localStorage.setItem('cctv_screens_v2', JSON.stringify(screens)); }, [screens]);
            useEffect(() => { localStorage.setItem('cctv_users_v2', JSON.stringify(users)); }, [users]);
            useEffect(() => { localStorage.setItem('cctv_external_v2', JSON.stringify(externalDepts)); }, [externalDepts]);
            useEffect(() => { localStorage.setItem('cctv_policies_v2', JSON.stringify(policyFiles)); }, [policyFiles]);
            useEffect(() => { const t = setInterval(() => setCurrentTime(new Date()), 1000); return () => clearInterval(t); }, []);

            const handleLogin = (e) => { 
                e.preventDefault();
                // تحويل الأرقام العربية إلى إنجليزية
                const normalizedCode = accessCode.trim().replace(/[٠-٩]/g, d => "٠١٢٣٤٥٦٧٨٩".indexOf(d)).replace(/[۰-۹]/g, d => "۰۱۲۳۴۵۶۷۸۹".indexOf(d));
                const u = users.find(x => x.code === normalizedCode); 
                if(u){ setCurrentUser(u); setLoginError(false); setAccessCode(''); } else setLoginError(true); 
            };
            const handleLogout = () => { setCurrentUser(null); setSelectedScreenId(null); setIsEditMode(false); setShowAdminPanel(false); setShowExternalPanel(false); setShowPolicyPanel(false); setSelectedCameraForControl(null); };

            const updateCameraData = (sid, cid, sec, data, isEdit = false, delId = null) => { setScreens(prev => prev.map(s => s.id !== sid ? s : { ...s, cameras: s.cameras.map(c => c.id !== cid ? c : { ...c, [sec]: sec === 'storage' ? { ...c.storage, ...data } : (delId !== null ? (c[sec]||[]).filter(x => x.id !== delId) : (isEdit ? (c[sec]||[]).map(x => x.id === data.id ? data : x) : [data, ...(c[sec]||[])])) })})); };
            const updateCameraInfo = (sid, cid, field, val) => { setScreens(prev => prev.map(s => s.id !== sid ? s : { ...s, cameras: s.cameras.map(c => c.id !== cid ? c : { ...c, [field]: val, lastUpdate: new Date().toLocaleTimeString('en-US', {hour12:false, hour:'2-digit', minute:'2-digit'}) }) })); };
            const updateScreen = (sid, field, val) => { setScreens(prev => prev.map(s => s.id !== sid ? s : { ...s, [field]: val })); };
            const updateStorage = (field, value) => { updateCameraData(selectedCameraForControl.screenId, selectedCameraForControl.camera.id, 'storage', { [field]: value }); };

            const askDelete = (type, id, secId = null, title = "تأكيد الحذف", msg = "هل أنت متأكد؟") => { setDeleteModal({ isOpen: true, type, id, secId, title, message: msg }); };
            const executeDelete = () => {
                const { type, id, secId } = deleteModal;
                if (type === 'screen') { setScreens(prev => prev.filter(s => s.id !== id)); setSelectedScreenId(null); setIsEditMode(false); }
                else if (type === 'camera') { setScreens(prev => prev.map(s => s.id !== id ? s : { ...s, cameras: s.cameras.filter(c => c.id !== secId) })); }
                else if (type === 'user') { setUsers(users.filter(u => u.id !== id)); }
                else if (type === 'external') { setExternalDepts(externalDepts.filter(d => d.id !== id)); }
                else if (type === 'policy') { setPolicyFiles(policyFiles.filter(f => f.id !== id)); if(viewingFile?.id === id) setViewingFile(null); }
                else if (['incident', 'recording', 'maintenance'].includes(type)) { updateCameraData(selectedCameraForControl.screenId, selectedCameraForControl.camera.id, type === 'incident' ? 'incidents' : type === 'recording' ? 'recordings' : 'maintenance', {}, false, id); }
                else if (type === 'reset') { setScreens(INITIAL_SCREENS); setUsers(INITIAL_USERS); setExternalDepts(INITIAL_EXTERNAL); setPolicyFiles(INITIAL_POLICIES); alert('تمت إعادة ضبط المصنع بنجاح'); }
                setDeleteModal({ ...deleteModal, isOpen: false });
            };

            const handleBack = () => { setSelectedScreenId(null); setIsEditMode(false); };
            const addNewScreen = () => { const newId = screens.length > 0 ? Math.max(...screens.map(s => s.id)) + 1 : 1; const newScreen = { id: newId, charId: String.fromCharCode(65 + (screens.length % 26)), name: `شاشة جديدة ${newId}`, location: '', status: 'active', cameras: [{ id: `${newId}-1`, number: 1, name: 'كاميرا 1', code: `CAM-${newId}-1`, status: 'active', note: '', lastUpdate: new Date().toLocaleTimeString('en-US'), storage: {dailyHours: 24, retentionDays: 30}, incidents: [], inspections: [], recordings: [], maintenance: [] }] }; setScreens([...screens, newScreen]); };
            const addNewCamera = (screenId) => { setScreens(prev => prev.map(s => s.id !== screenId ? s : { ...s, cameras: [...s.cameras, { id: `${screenId}-${Date.now()}`, number: s.cameras.length + 1, name: `كاميرا ${s.cameras.length + 1}`, code: `CAM-${screenId}-${s.cameras.length + 1}`, status: 'active', note: '', lastUpdate: new Date().toLocaleTimeString('en-US'), storage: {dailyHours: 24, retentionDays: 30}, incidents: [], inspections: [], recordings: [], maintenance: [] }] })); };
