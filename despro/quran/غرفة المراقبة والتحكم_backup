            const handleAddRecording = (e) => { e.preventDefault(); if(!recordingForm.signature && !editingItem) { alert('يجب توقيع المستلم أولاً'); return; } const newRec = { id: editingItem ? editingItem.id : Date.now(), date: new Date().toLocaleDateString('en-US'), handoverTime: new Date().toLocaleTimeString('en-US'), ...recordingForm, signature: recordingForm.signature || editingItem?.oldSignature }; updateCameraData(selectedCameraForControl.screenId, selectedCameraForControl.camera.id, 'recordings', newRec, !!editingItem); setRecordingForm({ recNum: '', reason: '', entity: '', signature: null }); setEditingItem(null); };
