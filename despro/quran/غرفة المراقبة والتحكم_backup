<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>غرفة المراقبة و التحكم CCTV</title>
    
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">

    <!-- 
      تنبيه: هذه الروابط تعمل عبر الإنترنت (CDN) لتشغيل الملف فوراً.
      لجعل الملف يعمل بدون إنترنت (Offline)، قم بتحميل هذه الملفات ووضعها في مجلد assets
      ثم غير الروابط لتشير إليها محلياً (مثل: src="assets/tailwindcss.js").
    -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gray: { 950: '#030712' },
                        slate: { 850: '#151e2e' }
                    },
                    fontFamily: {
                        sans: ['system-ui', '-apple-system', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <style>
        body {
            background-color: #030712;
            color: #f3f4f6;
            font-family: system-ui, -apple-system, sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        html:not(.dark) body {
            background-color: #f1f5f9;
            color: #020617;
        }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #111827; }
        ::-webkit-scrollbar-thumb { background: #374151; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #4b5563; }
        html:not(.dark) ::-webkit-scrollbar-track { background: #cbd5e1; }
        html:not(.dark) ::-webkit-scrollbar-thumb { background: #64748b; }
        html:not(.dark) ::-webkit-scrollbar-thumb:hover { background: #475569; }
        
        .pdf-container embed { width: 100%; height: 100%; border-radius: 0.5rem; }
    </style>
</head>
