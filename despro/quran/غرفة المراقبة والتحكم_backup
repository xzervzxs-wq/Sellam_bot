                            <button onClick={() => setShowExternalPanel(false)} className="bg-white dark:bg-gray-900 border border-slate-200 dark:border-gray-800 text-slate-600 dark:text-gray-400 hover:text-slate-900 dark:hover:text-white px-5 py-3 rounded-2xl flex items-center gap-2 font-bold transition-all shadow-sm hover:shadow-md">{getIcon('ArrowRight', {size:20})} عودة للمراقبة</button>
