                                                                        <div className="flex gap-1.5 flex-1">
                                                                            <button onClick={() => updateCameraInfo(activeScreen.id, cam.id, 'status', 'active')} className={`w-8 h-8 rounded-lg flex items-center justify-center transition-all ${cam.status === 'active' ? 'bg-green-600 text-white shadow-lg' : 'bg-slate-100 dark:bg-gray-800 text-slate-400'}`}>{getIcon('CheckCircle', {size:16})}</button>
                                                                            <button onClick={() => updateCameraInfo(activeScreen.id, cam.id, 'status', 'warning')} className={`w-8 h-8 rounded-lg flex items-center justify-center transition-all ${cam.status === 'warning' ? 'bg-orange-500 text-white shadow-lg' : 'bg-slate-100 dark:bg-gray-800 text-slate-400'}`}>{getIcon('AlertTriangle', {size:16})}</button>
                                                                            <button onClick={() => updateCameraInfo(activeScreen.id, cam.id, 'status', 'error')} className={`w-8 h-8 rounded-lg flex items-center justify-center transition-all ${cam.status === 'error' ? 'bg-red-600 text-white shadow-lg' : 'bg-slate-100 dark:bg-gray-800 text-slate-400'}`}>{getIcon('XCircle', {size:16})}</button>
                                                                        </div>
                                                                        <button onClick={() => confirmDeleteCamera(activeScreen.id, cam.id)} className="w-8 h-8 flex items-center justify-center text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors">{getIcon('Trash2', {size:18})}</button>
                                                                    </div>
                                                                ) : (
                                                                    <div className="flex justify-between items-center pt-3 border-t border-slate-50 dark:border-gray-900/50">
                                                                        <div className="flex items-center gap-2">
                                                                            <div className={`w-2.5 h-2.5 rounded-full ${cam.status === 'active' ? 'bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]' : 'bg-red-500'} animate-pulse`}></div>
                                                                            <span className={`text-[10px] font-black ${cam.status === 'active' ? 'text-green-600' : 'text-red-600'}`}>{cam.status === 'active' ? 'OPERATIONAL' : 'FAULT DETECTED'}</span>
                                                                        </div>
                                                                        <span className="text-[9px] text-slate-400 font-black tracking-tighter">LAST UPDATED: {cam.lastUpdate}</span>
                                                                    </div>
                                                                )}
                                                            </div>
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </div>
                        )}
                    </main>

                    <footer className="bg-white dark:bg-gray-900 border-t border-slate-200 dark:border-gray-800 py-6 px-10 mt-auto w-full transition-colors duration-300">
                        <div className="flex flex-row justify-between items-center w-full text-[11px] font-black text-slate-400 dark:text-gray-500 uppercase tracking-widest">
                            <div className="flex items-center gap-3 opacity-80"><div className="p-1.5 bg-yellow-500/10 rounded-lg">{getIcon('Lightbulb', {size:16, className:"text-yellow-500"})}</div><span>فكرة و إشراف : أنوار العايد - سارة الحربي</span></div>
                            <div className="flex items-center gap-3"><div className="p-1.5 bg-blue-600/10 rounded-lg">{getIcon('Shield', {size:16, className:"text-blue-600 dark:text-blue-500"})}</div><span>إدارة الأمن و السلامة - 2025</span></div>
                        </div>
                    </footer>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<SecurityDashboard />);
    </script>
</body>
</html>